@startuml
title Estrategia de particionamiento y sharding de Medly
left to right direction
skinparam shadowing false
skinparam componentStyle rectangle
skinparam packageStyle rectangle
skinparam defaultTextAlignment center
skinparam ArrowColor #55777A

component "Módulo B\nSQLAlchemy" as B
component "Módulo C\nSpring Data" as C
component "HAProxy SQL\nprimario / réplicas" as PgProxy
component "mongos ×2" as Mongos

package "PostgreSQL · tabla citas" as PgTable {
  database "HASH(cita_id)\ncitas_p0" as P0
  database "HASH(cita_id)\ncitas_p1" as P1
  database "HASH(cita_id)\ncitas_p2" as P2
  database "HASH(cita_id)\ncitas_p3" as P3
  database "..." as PMore
  database "HASH(cita_id)\ncitas_p7" as P7
}

package "MongoDB · eventos_auditoria" as MongoData {
  package "Shard 1 · Replica Set ×3" as S1 {
    database "primario + 2 réplicas" as S1Nodes
  }
  package "Shard 2 · Replica Set ×3" as S2 {
    database "primario + 2 réplicas" as S2Nodes
  }
}

B --> PgProxy : SQL
PgProxy --> P0 : hash(cita_id) = 0
PgProxy --> P1 : hash(cita_id) = 1
PgProxy --> P2 : hash(cita_id) = 2
PgProxy --> P3 : hash(cita_id) = 3
PgProxy --> PMore : hash(cita_id) = 4..6
PgProxy --> P7 : hash(cita_id) = 7
C --> Mongos : MongoDB driver
Mongos --> S1 : hash(citaId) → shard 1
Mongos --> S2 : hash(citaId) → shard 2

note bottom of PgTable
  8 particiones declarativas HASH.
  La clave primaria incluye cita_id,
  que es también la clave de partición.
end note
note bottom of MongoData
  La clave hashed distribuye eventos por citaId.
  La replicación de cada shard aporta HA;
  el sharding distribuye capacidad y datos.
end note
@enduml
