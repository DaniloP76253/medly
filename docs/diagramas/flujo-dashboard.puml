@startuml
title Medly — Flujo del panel y operaciones de citas
autonumber
skinparam shadowing false
skinparam sequenceMessageAlign center
skinparam ArrowColor #55777A

actor Usuario
participant "Frontend SPA\nNginx" as UI
participant "API Gateway\nMódulo A" as A
participant "Servicio de dominio\nMódulo B" as B
database PostgreSQL as PG
participant "Auditoría\nMódulo C" as C
database MongoDB as Mongo

Usuario -> UI : Abre panel
UI -> A : GET /api/dashboard/health
par salud de dominio y PostgreSQL
  A -> B : GET /health
  B -> PG : SELECT 1
  PG --> B : conexión OK
  B --> A : estado + X-Node-Id
and salud de auditoría y MongoDB
  A -> C : GET /api/auditoria/health
  C -> Mongo : ping
  Mongo --> C : conexión OK
  C --> A : estado + X-Node-Id
end
A --> UI : nodos, bases de datos, failovers observados

UI -> A : GET /api/citas
A -> B : GET /api/citas
B -> PG : SELECT citas ORDER BY creado_en
PG --> B : citas activas
B --> A : citas + X-Node-Id
A --> UI : lista de citas + X-Domain-Node

UI -> A : GET /api/auditoria/eventos
A -> C : GET /eventos
C -> Mongo : buscar eventos por timestamp
Mongo --> C : trazas con nodos origen
C --> A : eventos + X-Node-Id
A --> UI : auditoría + X-Audit-Node

Usuario -> UI : Registra cita / envía ráfaga
UI -> A : POST /api/citas
A -> B : POST /citas
B -> PG : INSERT cita
PG --> B : cita_id
B --> A : resultado + X-Node-Id
A -> C : POST /eventos\n(nodoGateway, nodoDominio)
C -> Mongo : INSERT evento\n(+ nodoAuditoria)
Mongo --> C : evento persistido
C --> A : auditoría registrada
A --> UI : 201 Created + nodo que atendió
UI --> Usuario : confirma y actualiza el panel
@enduml
